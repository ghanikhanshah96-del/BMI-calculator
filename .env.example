NEXT_PUBLIC_SITE_URL=https://fitnesscalculatorpro.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=you@example.com
RESEND_FROM_EMAIL=FitnessCalculatorPro.com <onboarding@resend.dev>

# Public browser configuration (actual values belong in .env.local)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server-only; use an authorized account for the blog project)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Shared with admin app for cache invalidation after publish/edit/delete
REVALIDATE_SECRET=generate-a-long-random-revalidate-secret

# Integrated admin (same website, /admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
# Firebase Storage bucket for durable admin image uploads
FIREBASE_STORAGE_BUCKET=

# Reviews and image storage
REVIEWS_TO_EMAIL=
# Use firestore for capped optimized images, or bucket for Firebase Storage.
MEDIA_STORAGE=firestore
# Optional separate secret (32+ characters); otherwise SESSION_SECRET is used.
REVIEWS_RATE_LIMIT_SECRET=
# Optional SMTP provider; complete configuration takes priority over Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
